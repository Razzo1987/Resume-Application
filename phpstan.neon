includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - routes/
        - themes/
        # Update script that runs before Laravel: it is analyzed too, and its functions
        # (used by App\Support\Update\PackageInspector) become known to PHPStan
        - resources/update/updater.php
    tmpDir: storage/framework/phpstan
