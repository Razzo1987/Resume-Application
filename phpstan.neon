includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - routes/
        - themes/
        # Script di aggiornamento che gira prima di Laravel: analizzato anche lui, e le sue funzioni
        # (usate da App\Support\Update\PackageInspector) diventano note a PHPStan
        - resources/update/updater.php
    tmpDir: storage/framework/phpstan
