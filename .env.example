APP_NAME="Resume App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Lingua di default dei contenuti (codice del language pack) e di riserva
APP_LOCALE=it-IT
APP_FALLBACK_LOCALE=en-GB
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Resume App
RESUME_ADMIN_PATH=admin
RESUME_ADMIN_LOCALE=it
RESUME_THEME=base
# Cache HTML delle pagine pubbliche (svuotata a ogni modifica dall'admin). In sviluppo si può spegnere.
RESUME_PAGE_CACHE=true
# Proxy davanti al sito (CDN, tunnel, Codespaces): "*" o elenco di IP. Vuoto se il sito non è dietro un proxy.
RESUME_TRUSTED_PROXIES=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=resume_app
DB_USERNAME=resume
DB_PASSWORD=

# Sessione: usata solo dal pannello admin (il sito pubblico non usa cookie)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Cache su file: veloce sugli hosting condivisi e senza tabelle aggiuntive
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
