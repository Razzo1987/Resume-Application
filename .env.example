APP_NAME="Resume App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Default content language (language pack code) and fallback language
APP_LOCALE=it-IT
APP_FALLBACK_LOCALE=en-GB
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Resume App
RESUME_ADMIN_PATH=admin
RESUME_ADMIN_LOCALE=it
RESUME_THEME=base
# HTML cache of the public pages (cleared at every change from the admin). Can be turned off in development.
RESUME_PAGE_CACHE=true
# Proxy in front of the site (CDN, tunnel, Codespaces): "*" or a list of IPs. Empty if the site is not behind a proxy.
RESUME_TRUSTED_PROXIES=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=resume_app
DB_USERNAME=resume
DB_PASSWORD=

# Session: used only by the admin panel (the public site uses no cookies)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# File cache: fast on shared hosting and needs no extra tables
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
